# Public site URL, without trailing slash. Required before indexing.
# Do not use a *.vercel.app preview host.
NEXT_PUBLIC_SITE_URL=

# Indexing stays off until this is exactly "true" AND the site URL is a real production host.
# Preview and development deployments stay noindex even if this flag is true.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Leave empty until confirmed. Never commit a fake number.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Both are required before POST /api/contact will transmit anything.
CONTACT_API_URL=
CONTACT_API_KEY=

# Optional. Analytics load only after consent, and only if this ID is set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
